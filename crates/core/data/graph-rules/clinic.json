      "category": "adjacency", "subject": "a clinical space", "predicate": "does not open into", "object": "another clinical space",
      "checkability": "deterministic", "confidence": 1.0,
      "rationale": "Clinical spaces are entered from the open ones.",
      "exceptions": [],
      "provenance": "specs/graph-building-generator.md, Hard Rules For Slice 1",
      "approved_by": "specs/graph-building-generator.md, Hard Rules For Slice 1",
      "check": {"between": ["clinical", "clinical"]}
