        {"what": "two exam rooms", "kinds": ["exam"], "at_least": 2},
        {"what": "a restroom", "kinds": ["restroom"], "at_least": 1},
        {"what": "a staff or nurse space", "kinds": ["staff_room", "nurse_station"], "at_least": 1},
