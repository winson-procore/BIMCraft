      "category": "graph", "subject": "every edge", "predicate": "joins", "object": "two spaces of the graph",
      "checkability": "deterministic", "confidence": 1.0,
      "rationale": "An edge to nothing is a graph that was not made right.",
      "exceptions": [],
      "provenance": "specs/graph-building-generator.md, Hard Rules For Slice 1",
      "approved_by": "specs/graph-building-generator.md, Hard Rules For Slice 1",
      "check": {}
    },
    {
      "id": "GR-002", "name": "private-reachable", "classification": "hard",
      "category": "access", "subject": "every private and clinical space", "predicate": "is reached from", "object": "a circulation, shared or public space",
      "checkability": "deterministic", "confidence": 1.0,
      "rationale": "A private space is entered from the open ones.",
